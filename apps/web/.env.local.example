# Explicit local-only simulation. Never use mock authentication in production.
AGENT_CITY_MODE=mock
# For real Auth + database, set mode=supabase and configure these server-only values:
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_PUBLISHABLE_KEY=your-local-publishable-or-anon-key
# No service role key or OpenAI key is needed for M0.

# Existing hosted project (optional alternative to local Supabase):
# AGENT_CITY_MODE=supabase
# SUPABASE_URL=https://atbksxlqgfxvetsgusek.supabase.co
# SUPABASE_PROJECT_REF=atbksxlqgfxvetsgusek
# SUPABASE_PUBLISHABLE_KEY=<configure securely, never a service-role or secret key>

# Opt-in server-only planning; keep disabled until the applicable additive migration is reviewed/applied.
AGENT_CITY_AI_PLANNING_ENABLED=false
# AGENT_CITY_AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_API_KEY=<configure securely on the server only>
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=<configure securely on the server only>
# SUPABASE_SERVICE_ROLE_KEY=<server-only; used solely for lease-bound plan finalization>
# Never use NEXT_PUBLIC_ names for credentials. M0 does not need these keys.

# M1.4 independent execution switch; planning/task approval never authorizes execution.
AGENT_CITY_RESEARCHER_EXECUTION_ENABLED=false
# Researcher always uses GEMINI_API_KEY/GEMINI_MODEL and the server-only finalizer key.

# Optional Researcher-only 503 retry, at most one extra request within the SAME 30s budget.
AGENT_CITY_RESEARCHER_503_RETRY_ENABLED=false

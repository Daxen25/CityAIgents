{
  "name": "agent-city",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace @agent-city/web",
    "build": "npm run build --workspace @agent-city/web",
    "start": "npm run start --workspace @agent-city/web",
    "typecheck": "npm run typecheck --workspace @agent-city/web",
    "test": "tsx --test packages/core/test/*.test.ts tests/*.test.ts",
    "test:planning-http": "node scripts/test-auth-persistence.mjs --planning && node scripts/test-auth-persistence.mjs --planning --openai && node scripts/test-auth-persistence.mjs --planning --persistence-failure",
    "test:orchestration-http": "node scripts/test-auth-persistence.mjs --orchestration",
    "test:researcher-http": "node scripts/test-auth-persistence.mjs --researcher",
    "test:runtime": "services/runtime/.venv/bin/python -m unittest discover -s services/runtime/tests -v",
    "check": "npm run typecheck && npm test && npm run test:runtime && npm run test:auth-persistence && npm run test:planning-http && npm run test:orchestration-http && npm run test:researcher-http && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "verify:supabase": "node --use-env-proxy --import tsx scripts/verify-supabase.ts",
    "verify": "npm run verify:supabase",
    "test:auth-persistence": "node scripts/test-auth-persistence.mjs"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "@electric-sql/pglite": "0.5.10"
  }
}
